{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ziyoufang.example/harness/contracts/model-advice.schema.json",
  "title": "ZiYouFangModelAdviceBatchV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "characterIndex",
          "issueCodes",
          "observations",
          "correctionSteps",
          "confidence",
          "needsRetry"
        ],
        "properties": {
          "characterIndex": { "type": "integer", "minimum": 0 },
          "issueCodes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "observations": {
            "type": "array",
            "maxItems": 3,
            "items": { "type": "string", "minLength": 1 }
          },
          "correctionSteps": {
            "type": "array",
            "maxItems": 3,
            "items": { "type": "string", "minLength": 1 }
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "needsRetry": { "type": "boolean" }
        }
      }
    }
  }
}
