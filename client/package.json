{
  "name": "@ziyoufang/client-verification",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preflight:toolchain": "node scripts/toolchain-preflight.mjs",
    "fixtures:generate": "swift ../harness/fixtures/generate-grid-fixtures.swift",
    "validate:arkts-core": "node scripts/arkts-core-validation.mjs",
    "validate:arkui-syntax": "node scripts/arkui-syntax-validation.mjs",
    "validate:arkui-transform": "node scripts/arkui-transform-validation.mjs",
    "validate:arkts-semantic": "node scripts/arkts-semantic-validation.mjs",
    "validate:android-host": "node scripts/android-host-validation.mjs",
    "validate:android-runtime": "node scripts/android-runtime-validation.mjs",
    "validate:android-avd-matrix": "node scripts/android-avd-matrix-validation.mjs",
    "validate:ios-host-source": "node scripts/ios-host-source-validation.mjs",
    "validate:platforms": "node scripts/platform-validation.mjs",
    "verify": "node scripts/verify.mjs",
    "test": "node --test scripts/*.test.mjs && node scripts/verify.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
