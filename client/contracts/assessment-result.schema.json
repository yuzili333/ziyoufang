{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ziyoufang.local/contracts/assessment-result.schema.json",
  "title": "ZiYouFangAssessmentResult",
  "type": "object",
  "required": ["localTaskId", "idempotencyKey", "status", "characters"],
  "properties": {
    "localTaskId": { "type": "string", "minLength": 1 },
    "idempotencyKey": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["local_pending", "uploading", "analyzing", "completed", "failed", "cancelled"]
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "index",
          "expectedCharacter",
          "recognizedCharacter",
          "boundingBox",
          "standardGlyphVersion",
          "score",
          "confidence",
          "category",
          "issues",
          "suggestion"
        ],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "expectedCharacter": { "type": "string", "minLength": 1 },
          "recognizedCharacter": { "type": "string" },
          "boundingBox": {
            "type": "object",
            "required": ["x", "y", "width", "height"]
          },
          "standardGlyphVersion": { "type": "string", "minLength": 1 },
          "score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "category": { "enum": ["normal", "wrong", "unattractive", "uncertain"] },
          "issues": { "type": "array" },
          "suggestion": { "type": "string" }
        }
      }
    }
  }
}
