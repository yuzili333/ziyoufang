# 本地开发示例。生产值仅写入 ECS 的 /opt/ziyoufang/secrets/prod.env，禁止提交真实密钥。
NODE_ENV=development
PORT=8080
PUBLIC_API_BASE_URL=https://lilicoconut.me

WECHAT_APP_ID=wxc7e8d08156f44970
WECHAT_APP_SECRET=replace-with-server-only-app-secret

MYSQL_ADDRESS=ziyoufang-mysql
MYSQL_PORT=3306
MYSQL_DATABASE=ziyoufang
MYSQL_USERNAME=ziyoufang_app
MYSQL_USER=ziyoufang_app
MYSQL_PASSWORD=replace-with-secret-manager-reference
MYSQL_ROOT_PASSWORD=replace-with-distinct-root-secret
MYSQL_SSL_MODE=VERIFY_IDENTITY
MYSQL_SSL_CA_FILE=/run/secrets/mysql-ca.pem
MYSQL_POOL_MAX=10

OSS_REGION=cn-chengdu
OSS_ENDPOINT=https://oss-cn-chengdu-internal.aliyuncs.com
OSS_PUBLIC_UPLOAD_HOST=https://lilicoconut.oss-cn-chengdu.aliyuncs.com
OSS_PUBLIC_ACCESS_HOST=https://lilicoconut.oss-cn-chengdu.aliyuncs.com
OSS_BUCKET=lilicoconut
OSS_RAM_ROLE_NAME=ziyoufang-ecs-role

SUBJECT_ID_HMAC_SECRET=replace-with-purpose-specific-secret
SESSION_TOKEN_PEPPER=replace-with-purpose-specific-secret
SHARE_TOKEN_SECRET=replace-with-purpose-specific-secret
BFF_HMAC_SECRET=replace-with-purpose-specific-secret
TELEMETRY_HASH_SECRET=replace-with-purpose-specific-secret

ASSESSMENT_SERVICE_BASE_URL=http://assessment:8080
ASSESSMENT_PROVIDER_MODE=font-smoke
GLYPH_PROVIDER_MODE=source-han-serif
CONSENT_VERSION=replace-with-compliance-approved-version
SHARE_CONSENT_VERSION=replace-with-compliance-approved-version
DELETION_CONFIRMATION_VERSION=replace-with-compliance-approved-version
QUOTA_POLICY_VERSION=replace-with-approved-version
QUOTA_WINDOW_MS=3600000
QUOTA_MAX_TASKS=30
WORKER_CONCURRENCY=1
ASSESSMENT_JOB_LEASE_MS=300000
ASSESSMENT_JOB_HEARTBEAT_MS=30000
EXPIRATION_CLEANUP_BATCH_LIMIT=100
