{
  "name": "ziyoufang-wechat-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "字有方微信小程序、云函数/BFF与智能评测服务工程",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sync:contracts": "node scripts/sync-contracts.mjs",
    "sync:assets": "node scripts/sync-assets.mjs",
    "typecheck:miniprogram": "tsc -p miniprogram/tsconfig.json",
    "test:contracts": "node --test tests/contracts-migration.test.mjs",
    "test:miniprogram-flow": "node --test tests/miniprogram-flow.test.mjs",
    "test:bff": "node --test cloudfunctions/assessmentBff/test/*.test.mjs",
    "test:assessment": "node --test assessment-service/test/*.test.mjs",
    "test:integration": "node --test tests/vertical-slice.test.mjs",
    "test": "npm run sync:contracts && npm run sync:assets && npm run typecheck:miniprogram && npm run test:contracts && npm run test:miniprogram-flow && npm run test:bff && npm run test:assessment && npm run test:integration",
    "validate:implementation": "node scripts/validate-implementation.mjs",
    "validate": "./harness/bin/validate"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "dependencies": {
    "jpeg-js": "0.4.4"
  }
}
