.confirm-page { padding-bottom: 60rpx; }
.preview { height: 700rpx; overflow: hidden; background: #e8e1d7; }
.preview image { width: 100%; height: 100%; }
.meta { margin: 24rpx 0; display: flex; justify-content: space-between; align-items: flex-start; }
.meta view { display: flex; flex-direction: column; gap: 8rpx; }
.target { max-width: 560rpx; font-family: STKaiti, KaiTi, serif; font-size: 32rpx; line-height: 1.5; }
.quality { padding: 26rpx; display: flex; flex-direction: column; gap: 18rpx; }
.quality view { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; color: #524d47; font-size: 24rpx; }
.quality .muted { line-height: 1.6; font-size: 22rpx; }
.upload-progress { position: relative; height: 44rpx; margin-top: 24rpx; overflow: hidden; border-radius: 22rpx; background: #eee7dc; text-align: center; line-height: 44rpx; font-size: 20rpx; }
.upload-progress view { position: absolute; inset: 0 auto 0 0; background: #e5bbb4; transition: width .2s ease; }
.upload-progress text { position: relative; z-index: 1; }
.cancel-upload { margin-top: 12rpx; background: transparent; color: #9f3026; font-size: 22rpx; }
.actions { margin-top: 32rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.actions button { width: 100%; border-radius: 44rpx; }
.primary { background: #c93627; color: #fff; }
.secondary { background: #eee7dc; color: #1d1b19; }
.offline, .cancel { margin-top: 18rpx; background: transparent; color: #9f3026; }
.cancel { color: #756f67; }
