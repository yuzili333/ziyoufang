.character { display: flex; align-items: center; gap: 24rpx; }
.character > text { width: 100rpx; height: 100rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid #d9b6ae; background: #fffdf8; font-family: STKaiti, KaiTi, serif; font-size: 68rpx; }
.character view { display: flex; flex-direction: column; gap: 10rpx; }
.character .muted { max-width: 500rpx; font-size: 22rpx; line-height: 1.5; }
.reasons { margin-top: 32rpx; display: grid; gap: 14rpx; }
.reasons button { width: 100%; margin: 0; padding: 24rpx; display: flex; gap: 18rpx; background: #fffdf8; text-align: left; border: 1rpx solid #ddd1c2; border-radius: 14rpx; }
.reasons button.active { border-color: #c93627; color: #a83228; }
textarea { width: 100%; min-height: 180rpx; margin-top: 28rpx; box-sizing: border-box; padding: 22rpx; background: #fffdf8; border-radius: 14rpx; }
.notice { margin-top: 22rpx; padding: 20rpx; background: #eee7dc; color: #675f57; border-radius: 12rpx; font-size: 22rpx; line-height: 1.6; }
.submit { margin-top: 32rpx; background: #c93627; color: #fff; border-radius: 44rpx; }
